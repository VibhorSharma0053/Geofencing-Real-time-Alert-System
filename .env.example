# ==============================================================================
# Database Configuration (PostgreSQL 16 + PostGIS 3.4)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geofence_db

# Local connection string used by host CLI and scripts
DATABASE_URL=postgres://postgres:postgres@localhost:5432/geofence_db?sslmode=disable

# Optional: Separate test database URL for running PostGIS integration tests (make test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/geofence_db?sslmode=disable

# ==============================================================================
# Backend Server Configuration
# ==============================================================================
# HTTP listen port (default: 8080)
PORT=8080

# CORS Allowed Origins: Comma-separated list of origins, or "*" for development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (per-client IP, applied to POST /vehicles/location)
# Sustained requests per second per IP (default: 50)
RATE_LIMIT_RPS=50

# Maximum burst capacity before 429 Too Many Requests is returned (default: 100)
RATE_LIMIT_BURST=100

# Optional API-Key Authentication (header: X-API-Key, or ?api_key= on /ws/alerts)
# Leave empty to DISABLE authentication (default, allowing evaluators to run freely)
# Example when enabled: API_KEY=mapup-secret-api-key-2026
API_KEY=

# ==============================================================================
# Frontend Client Configuration (Vite)
# ==============================================================================
# REST API base URL
VITE_API_URL=http://localhost:8080

# Optional WebSocket URL (derived automatically from VITE_API_URL if left empty)
VITE_WS_URL=

# Optional client API key (must match API_KEY if backend authentication is enabled)
VITE_API_KEY=
