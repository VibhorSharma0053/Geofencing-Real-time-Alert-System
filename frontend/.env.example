# Backend REST API endpoint (default: http://localhost:8080)
VITE_API_URL=http://localhost:8080

# Optional WebSocket endpoint (if omitted, automatically derived from VITE_API_URL)
# e.g. ws://localhost:8080/ws/alerts
VITE_WS_URL=

# Optional API key for backend authentication (sent as X-API-Key and ?api_key= on WS)
VITE_API_KEY=
